# GoHighLevel API Configuration
GHL_API_KEY=your_api_key_here
GHL_LOCATION_ID=your_location_id_here
GHL_CONVERSATION_AI_AGENT_ID=your_ai_agent_id_here
# Shared secret sent in X-GHL-Signature header by GHL webhook triggers
# Set this in GHL → Automations → Webhook action → Custom Headers
GHL_WEBHOOK_SECRET=your_ghl_webhook_secret_here

# Telegram Bot (live chat relay)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# Secret token for Telegram webhook — set when registering the webhook URL:
#   curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://recxchange.io/api/groq/telegram-webhook&secret_token=<TELEGRAM_WEBHOOK_SECRET>"
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here

# Supabase (live chat message relay — real-time Telegram ↔ website)
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# SendGrid Email Configuration
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=tom@recxchange.io

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://recxchange.io

# Analytics (optional)
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# ──────────────────────────────────────────────────────────────
# Security secrets (REQUIRED in production)
# ──────────────────────────────────────────────────────────────

# Protects internal/debug/test API endpoints (GET /api/test/*, /api/groq/telegram-test, etc.)
# Pass as header:  x-admin-secret: <value>
# Generate with:  openssl rand -hex 32
ADMIN_SECRET=your_admin_secret_here

# Protects cron-triggered email endpoints from public access.
# Vercel injects this automatically when CRON_SECRET is set in project env vars.
# Sent as:  Authorization: Bearer <value>
# Generate with:  openssl rand -hex 32
CRON_SECRET=your_cron_secret_here
