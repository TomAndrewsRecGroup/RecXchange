# GoHighLevel API Configuration
GHL_API_KEY=your_api_key_here
GHL_LOCATION_ID=your_location_id_here
GHL_CONVERSATION_AI_AGENT_ID=your_ai_agent_id_here

# Telegram Bot (live chat relay)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Supabase (live chat message relay — real-time Telegram ↔ website)
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# SendGrid Email Configuration
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=tom@recxchange.io

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://recxchange.io

# Analytics (optional)
NEXT_PUBLIC_ANALYTICS_ENABLED=false
